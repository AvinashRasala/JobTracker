# Database
DATABASE_URL=postgresql://jobtrack:jobtrack@localhost:5432/jobtrack

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
# Comma-separated list of allowed frontend origins (not JSON -- avoids a
# common env-var-parsing failure on hosts like Render).
ALLOWED_ORIGINS=http://localhost:3000
# Optional: also allow Vercel preview URLs, e.g. https://.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=

# Google OAuth (for Gmail integration)
# Create these at https://console.cloud.google.com -- see README for exact steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback
# Where users land after completing the Google OAuth flow.
FRONTEND_URL=http://localhost:3000
# Encrypts stored Gmail tokens. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# OpenAI (for AI features - later module)
OPENAI_API_KEY=
